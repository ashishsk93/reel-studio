{
  "name": "reel-studio",
  "private": true,
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --filter @reel/shared build && pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "db:migrate": "pnpm --filter @reel/api db:migrate",
    "db:seed": "pnpm --filter @reel/api db:seed",
    "db:reset": "pnpm --filter @reel/api db:reset"
  }
}

// Reel Studio data model. SQLite locally; kept Postgres-compatible:
// enum-like fields are Strings validated by zod unions from @reel/shared,
// lists/objects are Json, file paths are relative to DATA_DIR.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "sqlite"
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ---------- Influencers ----------

model Influencer {
  id                  String   @id @default(cuid())
  slug                String   @unique
  name                String
  age                 Int
  city                String
  identityBlock       String
  shortIdentity       String
  voiceNotes          String
  exampleLines        Json // string[]
  personality         String
  lane                String
  hashtag             String
  signatureDetails    Json // string[]
  forbiddenFeatures   Json // string[]
  conditionalFeatures Json // { feature, rule }[]
  defaultStyling      String
  homeOutfit          String
  homeSetting         String
  status              String   @default("active") // draft | creating | active | archived
  creatorBrief        Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  references   ReferenceImage[]
  creatorTasks CreatorTask[]
  projects     Project[]
}

model ReferenceImage {
  id            String   @id @default(cuid())
  influencerId  String
  path          String
  width         Int
  height        Int
  tags          Json // RefTag[]
  note          String   @default("")
  sortOrder     Int      @default(0)
  creatorTaskId String?  @unique
  createdAt     DateTime @default(now())

  influencer  Influencer   @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  creatorTask CreatorTask? @relation(fields: [creatorTaskId], references: [id], onDelete: SetNull)

  @@index([influencerId])
}

// One step in a new character's reference-image plan (anchor first, then the rest)
model CreatorTask {
  id             String   @id @default(cuid())
  influencerId   String
  order          Int
  tag            String
  purpose        String
  prompt         String
  promptOverride Boolean  @default(false) // prompt edited by hand or rewritten by Claude; don't rebuild
  imageModel     String
  modelReason    String
  attachments    Json // AttachmentRef[]
  status         String   @default("locked") // locked | ready | in_review | approved | skipped
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  influencer Influencer      @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  assets     Asset[]
  reference  ReferenceImage?

  @@index([influencerId, order])
}

model Source {
  id              String  @id @default(cuid())
  key             String  @unique // SOURCES in packages/shared/src/sources.ts
  displayName     String
  logoPath        String?
  priceMode       String // exact | under_band | hidden
  disclosureLines Json // string[]
  linkNotes       String  @default("")

  products Product[]
}

// ---------- Projects ----------

model Project {
  id              String    @id @default(cuid())
  influencerId    String
  format          String    @default("classic") // classic | haul | occasion | transition | three_ways (docs/formats.md)
  /// The project's name: "Kurtis under ₹499", "3 Diwali looks"; for classic, the product title. Never shown in the Reel.
  title           String
  occasion        String
  status          String    @default("draft")
  furthestStatus  String    @default("draft")
  videoMode       String    @default("multi_shot") // multi_shot | single (new projects are created as single)
  storyboardNotes Json? // string[] from the last storyboard generation
  postedAt        DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  influencer    Influencer      @relation(fields: [influencerId], references: [id])
  products      Product[]
  productImages ProductImage[]
  specs         ProductSpec[]
  scenes        Scene[]
  videoJobs     VideoJob[]
  assets        Asset[]
  segments      Segment[]
  composition   Composition?
  captions      CaptionPackage?
  renders       Render[]
  llmCalls      LlmCall[]
  jobs          Job[]
}

// One product of a project (classic and three_ways have one; hauls up to five).
model Product {
  id                String   @id @default(cuid())
  projectId         String
  order             Int
  title             String
  sourceId          String
  priceInr          Int
  priceModeOverride String?
  productUrl        String?
  affiliateLink     String?
  /// Short line shown on screen in hauls, e.g. "Pure cotton, 3 colours".
  note              String   @default("")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  project Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  source  Source         @relation(fields: [sourceId], references: [id])
  images  ProductImage[]
  spec    ProductSpec?
  scenes  Scene[]

  @@index([projectId, order])
}

model ProductImage {
  id        String @id @default(cuid())
  projectId String
  productId String
  path      String
  width     Int
  height    Int
  role      String // front | back | detail | pants | lifestyle | other
  order     Int

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([projectId, order])
  @@index([productId, order])
}

model ProductSpec {
  id               String   @id @default(cuid())
  projectId        String
  productId        String   @unique
  spec             Json
  mustMatch        Json // { key, label, expected }[]
  unknowns         Json // string[]
  garmentParagraph String
  version          Int      @default(1)
  editedByUser     Boolean  @default(false)
  updatedAt        DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Scene {
  id                String   @id @default(cuid())
  projectId         String
  productId         String? // the product this scene shows; null for a hook that shows none
  order             Int
  type              String
  purpose           String
  onScreenText      String
  /// Off: this scene gets no on-screen text overlay (so it doesn't cover the outfit).
  showText          Boolean  @default(true)
  targetDurationSec Float
  setting           String
  outfitState       String // own_clothes | wearing_product
  shotKind          String   @default("medium") // full_body | three_quarter | back | medium | closeup | hands
  description       String   @default("") // scene sentence(s) inserted into the prompt template
  productRoles      Json? // ProductImageRole[], most relevant first
  promptOverride    Boolean  @default(false) // imagePrompt was hand-edited; don't rebuild
  showsProduct      Boolean  @default(true)
  imagePrompt       String
  imageModel        String
  imageModelReason  String
  attachments       Json // AttachmentRef[]
  motion            String
  backgroundId      String? // ReferenceImage tagged "background" attached as the setting
  recommendation    Json? // the version to approve (Jev, or rules as fallback); refreshed after each review
  approvedAssetId   String?  @unique
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  project       Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  product       Product?           @relation(fields: [productId], references: [id], onDelete: SetNull)
  assets        Asset[]            @relation("SceneAssets")
  approvedAsset Asset?             @relation("SceneApproved", fields: [approvedAssetId], references: [id], onDelete: SetNull)
  segment       Segment?
  messages      AssistantMessage[]

  @@index([projectId, order])
}

// Uploaded generated image or video. Exactly one owner: scene, video job, or creator task.
model Asset {
  id             String   @id @default(cuid())
  projectId      String?
  sceneId        String?
  videoJobId     String?
  creatorTaskId  String?
  kind           String // image | video
  version        Int
  path           String
  normalizedPath String?
  mime           String
  width          Int
  height         Int
  durationSec    Float?
  probe          Json?
  detectedCuts   Json? // number[]
  shotBounds     Json? // { sceneId, start, end, inSec, outSec, matched, manual }[]
  frames         Json? // { t, path }[] frames extracted for the review
  status         String   @default("pending_review") // pending_review | approved | rejected
  sourcePrompt   String   @default("")
  createdAt      DateTime @default(now())

  project     Project?           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scene       Scene?             @relation("SceneAssets", fields: [sceneId], references: [id], onDelete: Cascade)
  approvedFor Scene?             @relation("SceneApproved")
  videoJob    VideoJob?          @relation(fields: [videoJobId], references: [id], onDelete: Cascade)
  creatorTask CreatorTask?       @relation(fields: [creatorTaskId], references: [id], onDelete: Cascade)
  reviews     Review[]
  segments    Segment[]
  messages    AssistantMessage[]

  @@index([sceneId])
  @@index([videoJobId])
  @@index([creatorTaskId])
}

model Review {
  id         String   @id @default(cuid())
  assetId    String
  verdict    String // pass | warn | fail
  summary    String   @default("")
  checklist  Json
  issues     Json
  fixPrompts Json
  shots      Json?
  model      String
  llmCallId  String?
  createdAt  DateTime @default(now())

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
}

model VideoJob {
  id             String   @id @default(cuid())
  projectId      String
  mode           String // multi_shot | single
  purpose        String   @default("main") // main | replacement (one shot re-generated as a single scene)
  order          Int
  active         Boolean  @default(true)
  prompt         String
  promptOverride Boolean  @default(false) // prompt edited by hand or rewritten by Claude; don't rebuild
  startAssetId   String
  endAssetId     String? // transitions: the Kling end frame
  recommendation Json? // the version to approve (Jev, or rules as fallback); refreshed after each review
  extraRefs      Json // AttachmentRef[]
  expectedShots  Json // { sceneId, start, end, text }[]
  settings       Json
  creditEstimate Float
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assets  Asset[]

  @@index([projectId, mode, order])
}

model Segment {
  id               String  @id @default(cuid())
  projectId        String
  sceneId          String  @unique
  assetId          String
  order            Int
  inSec            Float
  outSec           Float
  suggestedInSec   Float?
  suggestedOutSec  Float?
  onScreenText     String
  textBox          Json?
  detections       Json?
  badgeEnabled     Boolean @default(true)
  badgePlacement   Json?
  placementWarning String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scene   Scene   @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  asset   Asset   @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([projectId, order])
}

model Composition {
  id        String   @id @default(cuid())
  projectId String   @unique
  cta       Json
  cover     Json
  music     Json?
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model CaptionPackage {
  id           String   @id @default(cuid())
  projectId    String   @unique
  caption      String
  hashtags     Json
  firstComment String?
  dmTemplate   String
  coverTitles  Json
  sceneTexts   Json
  checklist    Json
  updatedAt    DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Render {
  id         String    @id @default(cuid())
  projectId  String
  status     String
  settings   Json
  outputDir  String
  probe      Json?
  qa         Json?
  warnings   Json
  createdAt  DateTime  @default(now())
  finishedAt DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// Modification assistant history: per asset, or per scene before any upload
model AssistantMessage {
  id        String   @id @default(cuid())
  assetId   String?
  sceneId   String?
  role      String // user | assistant
  content   String
  output    Json?
  createdAt DateTime @default(now())

  asset Asset? @relation(fields: [assetId], references: [id], onDelete: Cascade)
  scene Scene? @relation(fields: [sceneId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@index([sceneId])
}

// ---------- Infra ----------

model LlmCall {
  id               String   @id @default(cuid())
  task             String
  model            String
  projectId        String?
  influencerId     String?
  inputTokens      Int
  outputTokens     Int
  cacheReadTokens  Int      @default(0)
  cacheWriteTokens Int      @default(0)
  costUsd          Float
  latencyMs        Int
  attempts         Int      @default(1)
  ok               Boolean
  error            String?
  createdAt        DateTime @default(now())

  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([createdAt])
}

model Job {
  id             String    @id @default(cuid())
  type           String
  status         String    @default("queued") // queued | running | succeeded | failed | cancelled
  idempotencyKey String?   @unique
  projectId      String?
  payload        Json
  result         Json?
  error          String?
  progress       Float     @default(0)
  message        String    @default("")
  attempts       Int       @default(0)
  createdAt      DateTime  @default(now())
  startedAt      DateTime?
  finishedAt     DateTime?

  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([projectId])
}

// ---------- Instagram (own account only) ----------

/// Single row (id "me"): the connected account and its long-lived token.
model InstagramAccount {
  id             String    @id @default("me")
  igUserId       String?
  username       String?
  accessToken    String?
  tokenExpiresAt DateTime?
  /// Master switch for keyword auto-replies.
  autoReply      Boolean   @default(true)
  /// Shared by every Reel: the word commenters type, and an optional public reply under their comment.
  keyword        String    @default("LINK")
  commentReply   String?
  /// Poll recent posts for comments (works without webhooks, e.g. while the Meta app is in Development mode).
  poll           Boolean   @default(true)
  lastWebhookAt  DateTime?
  lastPollAt     DateTime?
  lastError      String?
  updatedAt      DateTime  @updatedAt
}

/// The DM a Reel's commenters get when they comment the keyword. One per Reel, since each
/// Reel has its own links. Reels without one (e.g. Meesho, whose app replies) are left alone.
model InstagramRule {
  id        String   @id @default(cuid())
  mediaId   String   @unique
  dmText    String
  enabled   Boolean  @default(true)
  projectId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A Reel published from the app.
model InstagramPost {
  id           String    @id @default(cuid())
  projectId    String
  renderId     String
  status       String // queued | uploading | processing | published | failed
  caption      String
  firstComment String?
  containerId  String?
  mediaId      String?
  permalink    String?
  error        String?
  createdAt    DateTime  @default(now())
  publishedAt  DateTime?

  @@index([projectId])
}

/// Every comment or DM the auto-replier acted on (or skipped), so nobody gets the same DM twice.
model InstagramReply {
  id           String   @id @default(cuid())
  kind         String // comment | dm
  /// Comment id or message id.
  sourceId     String   @unique
  mediaId      String?
  fromId       String
  fromUsername String?
  text         String
  ruleId       String?
  status       String // sent | failed | skipped
  detail       String?
  createdAt    DateTime @default(now())

  @@index([fromId, ruleId])
  @@index([createdAt])
}

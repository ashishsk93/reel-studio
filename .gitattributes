# LF everywhere, so Windows checkouts match (Prisma checksums migration.sql byte for byte).
* text=auto eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.mp4 binary
*.mov binary
*.mp3 binary
*.ttf binary
*.woff2 binary
*.zip binary
*.db binary

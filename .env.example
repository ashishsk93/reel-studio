ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_DEFAULT=claude-haiku-5-5
ANTHROPIC_MODEL_REVIEW=claude-haiku-5-5   # lets me switch reviews to a stronger model later
# live: real API calls (key required) | mock: canned fixtures, no key needed
# record: live calls saved as fixtures | replay: fixtures only
LLM_MODE=live
# Optional: OpenAI Decisions API for the app's decisions (copy guardrail, recommended version,
# badge check, cover frame); prompts and reviews stay on Claude. Leave blank to skip.
OPENAI_API_KEY=
OPENAI_DECISION_MODEL=gpt-6-luna
DATA_DIR=./data
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
PORT_API=4000
PORT_WEB=3000
